{
  "name": "kandamkulathi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": ">=10.34.7 <11"
  },
  "scripts": {
    "dev": "concurrently --kill-others -n public,workspaces,core,companion \"pnpm dev:public\" \"pnpm dev:workspaces\" \"pnpm dev:core\" \"pnpm dev:companion\"",
    "dev:public": "pnpm --filter @kandamkulathi/web-public dev",
    "dev:workspaces": "pnpm --filter @kandamkulathi/workspaces dev",
    "dev:core": "pnpm --filter @kandamkulathi/core-api dev",
    "dev:companion": "pnpm --filter @kandamkulathi/companion dev",
    "dev:mobile": "pnpm --filter @kandamkulathi/mobile dev",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:security": "node --test tests/security/*.test.mjs",
    "security:check": "node scripts/security/check.mjs",
    "audit:clients": "node scripts/security/artifacts.mjs",
    "security:tools": "node scripts/security/tools.mjs",
    "security:sast": "node scripts/security/scan.mjs sast",
    "security:secrets": "node scripts/security/scan.mjs secrets",
    "security:secrets:staged": "node scripts/security/scan.mjs staged",
    "security:runtime": "node scripts/security/runtime.mjs",
    "test:security:scanners": "node --test tests/security-scanners/*.test.mjs",
    "hooks:install": "node scripts/security/install-hooks.mjs",
    "prepare": "node scripts/security/install-hooks.mjs",
    "precommit": "node scripts/security/pre-commit.mjs",
    "build": "pnpm -r --if-present build",
    "test:e2e": "pnpm build && playwright test",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:security && pnpm build",
    "mobile:check": "pnpm --filter @kandamkulathi/mobile check",
    "db:generate": "pnpm --filter @kandamkulathi/database generate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "concurrently": "10.0.6",
    "semver": "7.8.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
