* text=auto eol=lf
## Unified-diff blank context lines contain one required space.
*.patch whitespace=-blank-at-eol
# Preserve vendored security rules byte-for-byte against upstream SHA-256 values.
.security/sast/vendor/** whitespace=-blank-at-eol,-blank-at-eof
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary
