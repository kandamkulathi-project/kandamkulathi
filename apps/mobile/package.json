{
  "name": "@kandamkulathi/mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "check": "expo install --check && expo config --type public",
    "build": "expo export --platform android --platform ios --output-dir dist"
  },
  "dependencies": {
    "@kandamkulathi/client": "workspace:*",
    "@kandamkulathi/i18n": "workspace:*",
    "expo": "58.0.16",
    "expo-audio": "58.0.9",
    "expo-camera": "58.0.11",
    "expo-constants": "58.0.12",
    "expo-crypto": "58.0.7",
    "expo-dev-client": "58.0.14",
    "expo-file-system": "58.0.10",
    "expo-font": "58.0.9",
    "expo-linking": "58.0.13",
    "expo-notifications": "58.1.5",
    "expo-secure-store": "58.0.2",
    "expo-web-browser": "58.0.6",
    "react": "19.3.0",
    "react-native": "0.88.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0"
  },
  "main": "index.ts"
}
