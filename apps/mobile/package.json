{
  "name": "@kandamkulathi/mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "check": "expo install --check && expo config --type public",
    "build": "expo export --platform android --platform ios --output-dir dist"
  },
  "dependencies": {
    "@kandamkulathi/i18n": "workspace:*",
    "expo": "58.0.17",
    "react": "19.3.0",
    "react-native": "0.88.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0"
  },
  "main": "index.ts"
}
