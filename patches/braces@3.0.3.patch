@@ -55,6 +55,14 @@ const parse = (input, options = {}) => {
 
   const advance = () => input[index++];
   const push = node => {
+    // Bound every parsed container before recursive AST walkers can consume it.
+    // Includes parentheses as well as braces; quoted/escaped text is unchanged.
+    if (node.nodes && stack.length > 100) {
+      const error = new SyntaxError('Brace AST nesting exceeds maximum depth (100)');
+      error.code = 'ERR_BRACES_MAX_DEPTH';
+      throw error;
+    }
+
     if (node.type === 'text' && prev.type === 'dot') {
       prev.type = 'text';
     }
