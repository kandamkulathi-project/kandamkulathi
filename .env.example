# Platform runtime fields are validated; business/provider adapters remain pending.
# Copy only the fields required by a specific service. Keep all secrets empty here.
APP_ENV=local
RESOURCE_NAMESPACE=kandamkulathi-local
PROVIDER_MODE=stub
ALLOW_LIVE_SENDS=false
ALLOW_LIVE_PAYMENTS=false
PUBLIC_WEB_URL=
PUBLIC_API_BASE_URL=
# Server-only exact canonical HTTPS origins, comma-separated; blank denies remote browser grants.
# Local development uses its fixed four existing loopback origins and refuses overrides.
BROWSER_ALLOWED_ORIGINS=
DATABASE_URL=
DATABASE_WORKER_URL=
# Admin URL is for the separate controlled migration/backup context, NEVER Worker runtime.
DATABASE_ADMIN_URL=
# Controlled runners only; never copy these fields into Worker bindings or client env files.
DATABASE_MIGRATION_URL=
DATABASE_BACKUP_URL=
DATABASE_RESTORE_URL=
BACKUP_KEY_B64=
BACKUP_KEY_ID=
PG_BIN_DIR=
PGSSLROOTCERT=
PLATFORM_TEST_ADMIN_URL=
PLATFORM_MANIFEST=
CHANGE_REVIEW_REFERENCE=
PLATFORM_CONFIRM_SYNTHETIC_NAMESPACE=
LOCAL_DATABASE_PROXY=
R2_OBJECT_MANIFEST=
PLATFORM_ALERT_TEST_URL=
APPROVED_ALERT_TEST=
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
WORKOS_REDIRECT_URI=
# Approved runtime identity configuration; blank values never enable a provider.
WORKOS_CONFIGURATION_APPROVED=
WORKOS_ISSUER=
WORKOS_AUDIENCE=
# JSON object mapping approved WorkOS organization IDs to internal organization UUIDs.
WORKOS_ORGANIZATION_MAPPINGS=
WEB_AUTH_API_ORIGIN=
WEB_AUTH_CALLBACK_URL=
WEB_AUTH_RETURN_URL=
WEB_AUTH_ALLOWED_RETURN_URLS=
# Distinct 32-byte base64url secrets, stored server-side only; never reuse the cookie key.
WEB_AUTH_COOKIE_KEY=
WEB_AUTH_RATE_KEY=
# Native private-scheme approval is separate from web/WorkOS account approval.
NATIVE_AUTH_CONFIGURATION_APPROVED=
NATIVE_AUTH_API_ORIGIN=
# Explicit JSON array of {environment,redirectUri}; no inferred callback allowlist.
NATIVE_AUTH_ALLOWED_REDIRECTS=
# Dedicated native 32-byte base64url encryption key, distinct from both web keys.
NATIVE_AUTH_ENCRYPTION_KEY=
# Enable only with reviewed public-corpus processing and an environment-scoped
# KNOWLEDGE_VECTORIZE Worker binding (1536 dimensions, cosine metric).
KNOWLEDGE_INDEX_CONFIGURATION_APPROVED=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=
OPENAI_TRANSCRIPTION_MODEL=
RAZORPAY_KEY_ID=
RAZORPAY_ACCOUNT_ID=
RAZORPAY_CONFIGURATION_APPROVED=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SHIPROCKET_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
SMS_API_KEY=
EMAIL_API_KEY=
TURN_CREDENTIAL_SECRET=
# R2/Vectorize/Queues/Durable Objects use reviewed environment-scoped Worker bindings.
# The entire local environment must never be uploaded as runtime secrets.
