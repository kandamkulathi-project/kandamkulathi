# Proposed configuration contract for scaffold implementation, not a runnable app config.
# Copy locally only after the actual config schema exists. Keep all secrets empty here.
APP_ENV=local
PROVIDER_MODE=stub
ALLOW_LIVE_SENDS=false
ALLOW_LIVE_PAYMENTS=false
PUBLIC_WEB_URL=
PUBLIC_API_BASE_URL=
DATABASE_URL=
# Admin URL is for the separate controlled migration/backup context, NEVER Worker runtime.
DATABASE_ADMIN_URL=
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
WORKOS_REDIRECT_URI=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=
OPENAI_TRANSCRIPTION_MODEL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SHIPROCKET_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
SMS_API_KEY=
EMAIL_API_KEY=
TURN_CREDENTIAL_SECRET=
# R2/Vectorize/Queues/Durable Objects use reviewed environment-scoped Worker bindings.
# The entire local environment must never be uploaded as runtime secrets.
